{
  "info": {
    "name": "Tuần 9 - BookStore JWT, users và reviews",
    "description": "Kiểm tra JSON Server thật ở localhost:3000 theo bài 1–3. Chạy theo thứ tự để login lấy token. Mỗi lần chạy tạo một review cho sách id 8 bằng tài khoản Test; không xóa dữ liệu. Tài khoản và mật khẩu trong collection là dữ liệu mẫu công khai của bài tập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Danh sách 20 sách",
      "request": { "method": "GET", "url": "{{baseUrl}}/books" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200 và đủ 20 sách', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.length(20); });",
        "pm.test('Sách 8 đúng yêu cầu', () => pm.expect(pm.response.json().find(b => b.id === 8).title).to.eql('Tư Duy Nhanh Và Chậm'));"
      ] } }]
    },
    {
      "name": "02 - Đăng nhập sai mật khẩu",
      "request": { "method": "POST", "url": "{{baseUrl}}/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"test@gmail.com\",\"password\":\"654321\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 Incorrect password', () => { pm.response.to.have.status(400); pm.expect(pm.response.json()).to.eql('Incorrect password'); });"
      ] } }]
    },
    {
      "name": "03 - Đăng ký trùng email",
      "request": { "method": "POST", "url": "{{baseUrl}}/register", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Test trùng email\",\"email\":\"test@gmail.com\",\"password\":\"123456\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 Email already exists', () => { pm.response.to.have.status(400); pm.expect(pm.response.json()).to.eql('Email already exists'); });"
      ] } }]
    },
    {
      "name": "04 - Đăng nhập Test lấy JWT",
      "request": { "method": "POST", "url": "{{baseUrl}}/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"test@gmail.com\",\"password\":\"123456\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Login 200', () => pm.response.to.have.status(200));",
        "const data = pm.response.json();",
        "pm.test('Có JWT và user 4, không trả password', () => { pm.expect(data.accessToken.split('.')).to.have.length(3); pm.expect(data.user.id).to.eql(4); pm.expect(data.user).not.to.have.property('password'); });",
        "pm.collectionVariables.set('token', data.accessToken);"
      ] } }]
    },
    {
      "name": "05 - Xác minh chính mình bằng Bearer",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/4", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('GET /users/4 trả đúng user', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.eql('test@gmail.com'); });"
      ] } }]
    },
    {
      "name": "06 - Thiếu token bị từ chối 401",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/4" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Không token nhận 401', () => pm.response.to.have.status(401));"
      ] } }]
    },
    {
      "name": "07 - Xem user người khác bị từ chối 403",
      "request": { "method": "GET", "url": "{{baseUrl}}/users/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Token Test không xem được user 1', () => pm.response.to.have.status(403));"
      ] } }]
    },
    {
      "name": "08 - Review sách 8 sắp xếp mới nhất trước",
      "request": { "method": "GET", "url": "{{baseUrl}}/reviews?bookId=8&_sort=createdAt&_order=desc" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('GET reviews 200', () => pm.response.to.have.status(200));",
        "const reviews = pm.response.json();",
        "pm.test('Chỉ sách 8, ngày giảm dần', () => { pm.expect(reviews.every(r => r.bookId === 8)).to.eql(true); pm.expect(reviews.every((r, i) => i === 0 || reviews[i-1].createdAt >= r.createdAt)).to.eql(true); });",
        "pm.collectionVariables.set('previousCount', reviews.length);"
      ] } }]
    },
    {
      "name": "09 - Bắt buộc: Test gửi review sách 8",
      "event": [
        { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('createdAt', new Date().toISOString());"] } },
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test('POST review 201', () => pm.response.to.have.status(201));",
          "const review = pm.response.json();",
          "pm.test('Đúng chủ token, sách 8, có id mới', () => { pm.expect(review.userId).to.eql(4); pm.expect(review.bookId).to.eql(8); pm.expect(review.rating).to.eql(5); pm.expect(review.id).to.be.a('number'); });",
          "pm.collectionVariables.set('createdReviewId', review.id);"
        ] } }
      ],
      "request": {
        "method": "POST", "url": "{{baseUrl}}/reviews",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{\"bookId\":8,\"userId\":4,\"userName\":\"Tài khoản Test\",\"rating\":5,\"comment\":\"Tuần 9 - kiểm tra bắt buộc: Test gửi review sách 8 qua Postman.\",\"createdAt\":\"{{createdAt}}\"}" }
      }
    },
    {
      "name": "10 - Review mới đã được lưu và đứng đầu",
      "request": { "method": "GET", "url": "{{baseUrl}}/reviews?bookId=8&_sort=createdAt&_order=desc" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('GET sau khi ghi 200', () => pm.response.to.have.status(200));",
        "const reviews = pm.response.json();",
        "pm.test('Tăng đúng một review và bản mới đứng đầu', () => { pm.expect(reviews.length).to.eql(Number(pm.collectionVariables.get('previousCount')) + 1); pm.expect(reviews[0].id).to.eql(Number(pm.collectionVariables.get('createdReviewId'))); });",
        "pm.collectionVariables.unset('token');"
      ] } }]
    }
  ]
}
